{
  "name": "llm-vault-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for llm-vault with local WebCrypto envelope decryption and zero-context secret injection.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llm-vault-mcp": "./dist/main.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  }
}
